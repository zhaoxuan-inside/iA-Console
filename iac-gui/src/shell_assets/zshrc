# iA-console 受控 zsh 启动文件（Q52）——与宿主 dotfiles 完全解耦：
# 不加载 starship/插件/别名/主题，仅提供 iA 调性极简提示符（排版即层级，无色块装饰）；
# 前景暗灰（ANSI 8）由 GUI 主题映射为纸感灰阶，昼夜两态均由主题保证可读。
HISTFILE="$ZDOTDIR/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt NO_BEEP
PROMPT=$'\n''%F{8}%~%f'$'\n''❯ '
RPS1=''

# 块式输出（Q54）：preexec/precmd 事件侧信道——US(\x1f) 分隔行写入 $IAC_EVENT_FILE，
# 供 GUI 解析命令块（命令文本/起止/退出码/cwd）；未设置该变量时静默跳过。
zmodload zsh/datetime 2>/dev/null
__iac_emit() { [ -n "$IAC_EVENT_FILE" ] && print -r -- "$1" >> "$IAC_EVENT_FILE" }
preexec() { __iac_emit $'S\x1f'"${EPOCHREALTIME:-$EPOCHSECONDS}"$'\x1f'"${1//$'\n'/\\n}" }
precmd()  { __iac_emit $'E\x1f'"${EPOCHREALTIME:-$EPOCHSECONDS}"$'\x1f'"$?"$'\x1f'"$PWD" }
