    { "term": "风险闸门", "code_name": "risk_gate", "definition": "执行前的强制检查点：按风险评估结果决定放行、要求确认或拒绝；人类与 Agent 执行一律经过", "aliases": ["执行闸门"], "domain": "风险", "related_terms": ["风险评估"], "source": "_04_framework_design/02_data_flow.md" },
    { "term": "错误诊断", "code_name": "Diagnosis", "definition": "对失败执行的结构化分析：根因假设（须引用 stderr 证据）、置信度、修复提案列表", "aliases": ["诊断报告"], "domain": "智能", "related_terms": ["修复提案"], "source": "_01_business/01_requirements.md" },
    { "term": "修复提案", "code_name": "FixProposal", "definition": "诊断给出的候选修复命令，采纳后走与普通提案相同的执行闸门", "aliases": [], "domain": "智能", "related_terms": ["错误诊断", "提案"], "source": "_01_business/01_requirements.md" },
    { "term": "进程间通信", "code_name": "ipc", "definition": "前端/本地客户端与 daemon 的通信通道：Unix domain socket / Windows named pipe，JSONL 信封协议", "aliases": ["IPC"], "domain": "接入", "related_terms": ["模型上下文协议"], "source": "_03_tech_stack/ADR-005-access-mcp-ipc.md" },
    { "term": "模型上下文协议", "code_name": "mcp", "definition": "面向外部 Agent 的标准工具协议，iA-console 以 stdio MCP Server 暴露 iac_ 前缀工具集", "aliases": ["MCP", "Agent接口"], "domain": "接入", "related_terms": ["进程间通信"], "source": "_03_tech_stack/ADR-005-access-mcp-ipc.md" },
    { "term": "模型后端", "code_name": "AiProvider", "definition": "一个可调用的 LLM 服务配置档案：名称、base_url、模型、鉴权来源；走 OpenAI 兼容协议，可插拔切换", "aliases": ["AI后端", "供应商"], "domain": "智能", "related_terms": ["模型调用"], "source": "_03_tech_stack/ADR-006-llm-openai-compatible.md" },
    { "term": "模型调用", "code_name": "AiRequest", "definition": "对模型后端的一次补全请求：system+messages、温度、超时；返回统一 LlmResponse", "aliases": ["补全请求"], "domain": "智能", "related_terms": ["模型后端"], "source": "_06_interface_design/02_internal_interfaces.md" },
    { "term": "平台", "code_name": "Platform", "definition": "目标操作系统三值：linux|macos|windows（方案库另有 all），决定 shell 语法与提案生成目标", "aliases": ["操作系统"], "domain": "全局", "related_terms": ["方案", "习惯方言"], "source": "_01_business/01_requirements.md" },
    { "term": "习惯方言", "code_name": "HabitDialect", "definition": "用户配置的偏好命令方言（linux|macos|windows），直接输入命令时作为翻译源方言；等于主机平台时不翻译", "aliases": ["偏好方言"], "domain": "翻译", "related_terms": ["平台", "命令翻译"], "source": "_01_business/01_requirements.md" },
    { "term": "命令翻译", "code_name": "CommandTranslation", "definition": "把习惯方言命令映射为主机平台等价命令：静态映射表优先（零 AI 成本），未命中 AI 兜底并回写缓存；结果以提案呈现，不静默执行", "aliases": ["方言翻译", "命令转换"], "domain": "翻译", "related_terms": ["习惯方言", "提案"], "source": "_02_principle/01_candidates.md" },
    { "term": "模型插件", "code_name": "ModelPlugin", "definition": "可下载安装的本地推理资产包：引擎二进制（llama-server）+ GGUF 模型权重 + 清单（sha256/大小/上下文长度），来源为 HuggingFace/魔搭/镜像", "aliases": ["模型包"], "domain": "智能", "related_terms": ["模型仓库", "本地引擎"], "source": "_03_tech_stack/ADR-007-local-model-plugin.md" },
    { "term": "模型仓库", "code_name": "modelhub", "definition": "infra 模块：模型插件的下载、校验（sha256、断点续传）、安装、列表与删除", "aliases": ["插件中心"], "domain": "智能", "related_terms": ["模型插件"], "source": "_04_framework_design/01_architecture.md" },
    { "term": "本地引擎", "code_name": "LocalEngine", "definition": "modelhub 安装的 llama-server 子进程，提供 OpenAI 兼容本地端点，注册为 Provider 档案 local-builtin，对 core 与云后端无差别", "aliases": ["内置引擎", "local-builtin"], "domain": "智能", "related_terms": ["模型插件", "模型后端"], "source": "_03_tech_stack/ADR-007-local-model-plugin.md" },
    { "term": "参数映射", "code_name": "ParamMapping", "definition": "翻译条目中源命令参数到目标命令参数的逐项对应，四类：direct（直映）/renamed（改名）/value_transform（值变换）/none（无等价，附替代建议）", "aliases": ["参数对应"], "domain": "翻译", "related_terms": ["命令翻译"], "source": "_02_principle/01_candidates.md" },
    { "term": "组合翻译", "code_name": "CompositionTranslation", "definition": "无法一对一映射时由 AI 规划命令组合并生成平台化脚本：确认后存方案库（kind=script）并登记进翻译映射（kind=composition），此后静态命中零 AI 成本", "aliases": ["组合规划", "脚本翻译"], "domain": "翻译", "related_terms": ["命令翻译", "方案"], "source": "_02_principle/01_candidates.md" },
    { "term": "输入标记", "code_name": "InputMarker", "definition": "仅在 iA 输入框解析的用户标记集：??（AI 唤起）/(管理命令)/---（任务分隔）/#（备注）/\\（转义字面），不改变 shell 语义", "aliases": ["标记语言", "魔法前缀"], "domain": "接入", "related_terms": ["模型上下文协议"], "source": "_06_interface_design/01_external_api.md" },
    { "term": "主题", "code_name": "Theme", "definition": "TUI 配色令牌表（10 个语义令牌），模式 day/night/auto（auto 跟随终端背景），真彩优先并向 256/16 色优雅降级", "aliases": ["配色", "皮肤"], "domain": "体验", "related_terms": ["习惯方言"], "source": "_04_framework_design/03_ui_principles.md" },
    { "term": "回滚日志", "code_name": "RollbackJournal", "definition": "按全局单调 seq 记录每次执行的文件级效果（op=created|modified|deleted|renamed，含前后像引用），回滚=逆序回放到任意执行点；不逐命令判断可逆性", "aliases": ["效果日志", "操作日志"], "domain": "回滚", "related_terms": ["效果条目", "快照仓库"], "source": "_02_principle/01_candidates.md" },
    { "term": "效果条目", "code_name": "EffectEntry", "definition": "回滚日志中单文件一条记录：路径、操作类型、前像/后像内容引用、捕获范围标记（in|out_of_scope）", "aliases": [], "domain": "回滚", "related_terms": ["回滚日志"], "source": "_06_interface_design/02_internal_interfaces.md" },
    { "term": "快照仓库", "code_name": "SnapshotStore", "definition": "内容寻址的前像/后像存储（去重+压缩，位于 ~/.local/share/iac/snapshots/），小文件全量复制、大文件 reflink/硬链接、超限仅记路径", "aliases": ["内容仓库"], "domain": "回滚", "related_terms": ["回滚日志", "回收策略"], "source": "_02_principle/01_candidates.md" },
    { "term": "回收策略", "code_name": "RetentionPolicy", "definition": "快照与回收站的统一清理策略：默认保留 7 天/1GB（LRU），到期自动清理；删除类回滚效果先入回收站而非直接抹除", "aliases": ["保留策略"], "domain": "回滚", "related_terms": ["快照仓库"], "source": "_02_principle/01_candidates.md" }
  ]
}
