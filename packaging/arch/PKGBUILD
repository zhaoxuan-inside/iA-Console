# Maintainer: zhaoxuan <zhaoxuan@users.noreply.github.com>
# iA Console v0.1.0 — 独立 GUI 客户端 + daemon + CLI/TUI/MCP
# 本地构建：在 packaging/arch/ 下执行 makepkg -f（需 rust/cargo，或 rustup 工具链在 PATH）

pkgname=ia-console
pkgver=0.1.0
pkgrel=1
pkgdesc="天下没有难用的 Console（智能控制台：真终端 + AI 侧栏 + 闸门执行 + 会话持久化）"
arch=('x86_64')
url="https://github.com/zhaoxuan/iA-console"
license=('MIT')
depends=('glibc' 'gcc-libs')
makedepends=('cargo' 'rust')
optdepends=('kitty: 推荐终端字体渲染环境')
source=()
sha256sums=()
options=('!strip' '!emptydirs')
DLAGENTS=()

build() {
  cd "$srcdir"
  # 源码即仓库根（本地包：从 startdir 取工程）
  # Arch 全局 CFLAGS 的 -flto=auto 会用系统 clang 产 LTO 字节码，rust-lld 无法消费
  # （sqlite3 符号全部丢失）——构建 cc 原生库前必须剥离
  export CFLAGS="$(printf '%s' "$CFLAGS" | tr ' ' '\n' | grep -v -- '-flto' | tr '\n' ' ')"
  export CXXFLAGS="$(printf '%s' "$CXXFLAGS" | tr ' ' '\n' | grep -v -- '-flto' | tr '\n' ' ')"
  export CARGO_TARGET_DIR="$srcdir/target"
  repo="$startdir"
  (cd "$repo" && cargo build --release --workspace)
  # 供 package() 取产物（CARGO_TARGET_DIR=$srcdir/target）
  ls -la "$srcdir/target/release/ia-console" > /dev/null
  cp "$startdir/../../dist/ia-console-0.1.0-linux-x64/ia-console.desktop" "$srcdir/"
  python3 "$startdir/../../scripts/gen-icon.py" "$srcdir/ia-console.png"
}

package() {
  install -Dm755 "$srcdir/target/release/ia-console" "$pkgdir/usr/bin/ia-console"
  install -Dm755 "$srcdir/target/release/iac"        "$pkgdir/usr/bin/iac"
  install -Dm755 "$srcdir/target/release/iacd"       "$pkgdir/usr/bin/iacd"
  install -Dm644 "$srcdir/ia-console.desktop" "$pkgdir/usr/share/applications/ia-console.desktop"
  install -Dm644 "$srcdir/ia-console.png"     "$pkgdir/usr/share/icons/hicolor/256x256/apps/ia-console.png"
  install -Dm644 "$startdir/../../LICENSE"    "$pkgdir/usr/share/licenses/ia-console/LICENSE"
  install -Dm644 "$startdir/../../README.md"  "$pkgdir/usr/share/doc/ia-console/README.md"
}
